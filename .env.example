# Copy to .env and fill in. Never commit the filled-in file.
#
# The token pepper must be the same in every process that validates a token: the
# API, each worker and the reaper. Compose passes it to all of them from here.
FORGESIGHT_TOKEN_PEPPER=change-me-to-a-long-random-value

POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=forgesight
S3_SECRET_KEY=change-me

# Bind to loopback by default. Set 0.0.0.0 only behind a reverse proxy with TLS:
# the API is plain HTTP and its tokens are bearer tokens.
FORGESIGHT_BIND=127.0.0.1

# local | public. Public mode creates sandbox workspaces with a 24 h TTL, meters
# session creation, disables the evaluation and benchmark endpoints, and shows a
# banner on every page.
FORGESIGHT_MODE=local
